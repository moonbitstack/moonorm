name = "moonbitstack/moonorm"

version = "0.11.10"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonorm"

license = "Apache-2.0"

keywords = [
  "orm",
  "sql",
  "database",
  "query-builder",
  "sql-toolkit",
  "mapper",
  "data-mapper",
  "migration",
  "migrations",
  "schema",
  "session",
  "unit-of-work",
  "sqlite",
  "postgres",
  "postgresql",
  "mysql",
  "sqlalchemy",
  "moondb",
  "moonbit",
]

description = "An ORM and SQL toolkit for MoonBit."

import {
  "moonbitstack/moondb@0.3.0",
  "moonbitstack/moonast@0.3.0",
  "moonbitlang/parser@0.4.8",
  "moonbitlang/async@0.22.5",
}

source = "src"
