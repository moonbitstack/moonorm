// The moonorm end-to-end suite: it depends on the published moonorm ORM and the
// published moonsqlite driver, opens a real SQLite database, and drives the whole
// stack — migrations, Session CRUD, a CTE/subquery SELECT, and an optimistic-locked
// update — through it. moonsqlite links the vendored amalgamation, so the package
// is native-only.
supported_targets = "native"

import {
  "moonbitstack/moonorm" @orm,
  "moonbitstack/moonsqlite" @sqlite,
  "moonbitstack/moondb",
  "moonbitstack/moondb/pool",
}
