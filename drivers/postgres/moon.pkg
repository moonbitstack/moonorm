// moonpostgres: a pure-MoonBit PostgreSQL wire-protocol driver (v3), no C.
// The connection layer rides moonbitlang/async sockets, so the package is
// native-only (the async runtime has no JS/wasm backend). PgConn implements
// @moondb.AsyncDriver — the async half of the moondb seam, which exists because
// a socket-backed driver cannot satisfy the synchronous @moondb.Driver at all.
supported_targets = "native"

import {
  "moonbitstack/mooncrypt/spec",
  "moonbitstack/mooncrypt/hash/md5",
  "moonbitstack/mooncrypt/hash/sha2",
  "moonbitstack/mooncrypt/mac/hmac",
  "moonbitstack/mooncrypt/kdf/pbkdf2",
  "moonbitstack/moonbase/base16",
  "moonbitstack/moonbase/base64",
  "moonbitstack/moondb",
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/async/io",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/double",
}
