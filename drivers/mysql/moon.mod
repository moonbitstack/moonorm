name = "moonbitstack/moonmysql"

version = "0.7.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonorm"

license = "Apache-2.0"

keywords = [ "mysql", "driver", "moondb", "wire", "database", "protocol" ]

description = "Pure-MoonBit MySQL wire-protocol driver implementing @moondb.Driver — no C, like PyMySQL."

preferred_target = "native"

import {
  "moonbitstack/moonbase@0.4.0",
  "moonbitstack/mooncrypt@0.3.0",
  "moonbitstack/mooncred@0.6.0",
  "moonbitstack/moondb@0.1.8",
  "moonbitstack/moonvar@0.2.0",
  "moonbitlang/async@0.20.3",
}
