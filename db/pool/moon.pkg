// A connection pool over any moondb driver, kept out of the interface package so a
// driver that only implements `Driver` carries none of the pool's dependencies. The
// bookkeeping — how many are live, which are idle, when each was born — is
// moonpool's; this package adds opening, closing and probing connections.
import {
  "moonbitstack/moondate",
  "moonbitstack/moondb",
  "moonbitstack/moonpool",
}

import {
  "moonbitstack/moondb",
} for "test"
