// The generator behind `#orm.table`, `#orm.column` and `#orm.skip`: the model of
// each annotated struct, as `T::model()`. moonx runs it as a dev_build rule; see
// the README.
supported_targets = "+native+wasm"

pkgtype(kind: "executable")

import {
  "moonbitstack/moonast/quote",
  "moonbitstack/moonast/attr",
  "moonbitstack/moonast/gen",
  "moonbitstack/moonast/cli",
  "moonbitlang/parser/attribute",
  "moonbitlang/core/list",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}
