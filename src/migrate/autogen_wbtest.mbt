///|
/// A `users` table as a model would declare it: an integer key, a required name, a
/// unique email, and an index on the name.
fn declared_users() -> @schema.TableSpec {
  @schema.TableSpec::new(
    "users",
    [
      @schema.column("id", IntType, primary_key=true, autoincrement=true),
      @schema.column("name", TextType, nullable=false),
      @schema.column("email", TextType, unique=true),
    ],
    indexes=[@schema.index(["name"], name="ix_users_name")],
  )
}

///|
test "autogenerate creates a table and its indexes for a table the database lacks" {
  let changes = autogenerate_changes([declared_users()], [])
  assert_eq(changes.length(), 2)
  assert_eq(
    changes[0].up.to_sql(Sqlite)[0],
    "CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, email TEXT UNIQUE)",
  )
  assert_eq(
    changes[1].up.to_sql(Sqlite)[0],
    "CREATE INDEX ix_users_name ON users (name)",
  )
  // The downgrade drops the index before the table it depends on.
  assert_eq(
    changes[1].down.to_sql(Sqlite)[0],
    "DROP INDEX IF EXISTS ix_users_name",
  )
  assert_eq(changes[0].down.to_sql(Sqlite)[0], "DROP TABLE IF EXISTS users")
}

///|
test "autogenerate adds a new column and drops a vanished one" {
  let live = @schema.TableSpec::new("users", [
    @schema.column("id", IntType, primary_key=true, autoincrement=true),
    @schema.column("name", TextType, nullable=false),
    @schema.column("email", TextType, unique=true),
    @schema.column("legacy", TextType),
  ])
  let declared = @schema.TableSpec::new("users", [
    @schema.column("id", IntType, primary_key=true, autoincrement=true),
    @schema.column("name", TextType, nullable=false),
    @schema.column("email", TextType, unique=true),
    @schema.column("age", IntType),
  ])
  let ops = autogenerate([declared], [live])
  assert_eq(ops.map(op => op.to_sql(Postgres)[0]), [
    "ALTER TABLE users ADD COLUMN age INTEGER", "ALTER TABLE users DROP COLUMN legacy",
  ])
}

///|
test "autogenerate notices a type change, and compares it as the dialect writes it" {
  let declared = @schema.TableSpec::new("counters", [
    @schema.column("id", IntType, primary_key=true),
    @schema.column("hits", BigIntType),
  ])
  let live = @schema.TableSpec::new("counters", [
    @schema.column("id", IntType, primary_key=true),
    @schema.column("hits", IntType),
  ])
  // Without a dialect the declared types differ, so it is a change.
  assert_eq(autogenerate([declared], [live]).length(), 1)
  // SQLite stores both as INTEGER, so physically nothing moved.
  assert_eq(autogenerate([declared], [live], dialect=Sqlite).length(), 0)
  assert_eq(
    autogenerate([declared], [live], dialect=Postgres).map(op => {
      op.to_sql(Postgres)[0]
    }),
    ["ALTER TABLE counters ALTER COLUMN hits TYPE BIGINT"],
  )
}

///|
test "autogenerate reports a nullability change but never one on a primary key" {
  let declared = @schema.TableSpec::new("t", [
    @schema.column("id", IntType, primary_key=true),
    @schema.column("name", TextType, nullable=false),
  ])
  // SQLite reports INTEGER PRIMARY KEY as nullable; that is the rowid, not a change.
  let live = @schema.TableSpec::new("t", [
    @schema.column("id", IntType, primary_key=true, nullable=true),
    @schema.column("name", TextType, nullable=true),
  ])
  assert_eq(
    autogenerate([declared], [live], dialect=Sqlite).map(op => {
      op.to_sql(Postgres)[0]
    }),
    ["ALTER TABLE t ALTER COLUMN name SET NOT NULL"],
  )
}

///|
test "autogenerate drops a table the model no longer declares" {
  let live = @schema.TableSpec::new("old_heroes", [
    @schema.column("id", IntType, primary_key=true),
  ])
  let ops = autogenerate([], [live])
  assert_eq(ops.map(op => op.to_sql(Sqlite)[0]), [
    "DROP TABLE IF EXISTS old_heroes",
  ])
}

///|
test "autogenerate adds a missing index, drops an unknown one, and replaces a changed one" {
  let declared = @schema.TableSpec::new(
    "heroes",
    [@schema.column("id", IntType, primary_key=true)],
    indexes=[
      @schema.index(["name"], name="ix_heroes_name"),
      @schema.index(["power"], name="ix_heroes_power"),
    ],
  )
  let live = @schema.TableSpec::new(
    "heroes",
    [@schema.column("id", IntType, primary_key=true)],
    indexes=[
      @schema.index(["power", "name"], name="ix_heroes_power"),
      @schema.index(["age"], name="ix_heroes_age"),
    ],
  )
  let changes = autogenerate_changes([declared], [live])
  let up = changes.map(change => change.up.to_sql(Sqlite)[0])
  assert_eq(up, [
    "CREATE INDEX IF NOT EXISTS ix_heroes_name ON heroes (name)", "DROP INDEX IF EXISTS ix_heroes_power",
    "CREATE INDEX ix_heroes_power ON heroes (power)", "DROP INDEX IF EXISTS ix_heroes_age",
  ])
}

///|
test "an autogenerated revision undoes itself in reverse order" {
  let declared = [declared_users()]
  let revision = autogenerate_revision(id="0001", name="add users", declared, [])
  assert_eq(revision.up.length(), 2)
  assert_eq(revision.down.map(op => op.to_sql(Sqlite)[0]), [
    "DROP INDEX IF EXISTS ix_users_name", "DROP TABLE IF EXISTS users",
  ])
}

///|
test "index rows group into indexes across the three ways a flag arrives" {
  let rows : Array[@moondb.Row] = [
    {
      columns: ["table", "index", "is_unique", "column"],
      values: [
        @moondb.Text("heroes"),
        @moondb.Text("ix_name"),
        @moondb.Bool(true),
        @moondb.Text("name"),
      ],
    },
    {
      columns: ["table", "index", "is_unique", "column"],
      values: [
        @moondb.Text("heroes"),
        @moondb.Text("ix_name"),
        @moondb.Bool(true),
        @moondb.Text("power"),
      ],
    },
    {
      columns: ["table", "index", "is_unique", "column"],
      values: [
        @moondb.Text("heroes"),
        @moondb.Text("ix_age"),
        @moondb.Int(0),
        @moondb.Text("age"),
      ],
    },
  ]
  let indexes = indexes_of_rows(rows)
  assert_eq(indexes.length(), 2)
  assert_eq(indexes[0].name, "ix_name")
  assert_eq(indexes[0].columns, ["name", "power"])
  assert_eq(indexes[0].unique, true)
  assert_eq(indexes[1].unique, false)
}

///|
test "table names are read off the first column of any reflection query" {
  let rows : Array[@moondb.Row] = [
    { columns: ["table_name"], values: [@moondb.Text("heroes")], },
    { columns: ["table_name"], values: [@moondb.Text("teams")], },
  ]
  assert_eq(table_names_of(rows), ["heroes", "teams"])
}

///|
test "a schema snapshot is stable and names what changed" {
  let schema = @schema.Schema::new([
    declared_users(),
    @schema.TableSpec::new("teams", [
      @schema.column("id", IntType, primary_key=true),
    ]),
  ])
  let text = schema.snapshot(Sqlite)
  assert_eq(text, schema.snapshot(Sqlite))
  assert_eq(text.contains("table teams"), true)
  assert_eq(text.contains("column name TEXT not null"), true)
  assert_eq(text.contains("index ix_users_name (name)"), true)
  let other = @schema.Schema::new([declared_users()])
  assert_eq(text == other.snapshot(Sqlite), false)
}
